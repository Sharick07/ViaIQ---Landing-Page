---
import PlanCard from './PlanCard.astro';

const plans = [
  {
    id: 'FREE' as const,
    name: 'Free',
    price: '$0',
    period: 'para siempre',
    description: 'Comienza a organizar tu pipeline sin costo.',
    features: [
      '1 agente (solo owner)',
      '5 perfiles de cliente por mes',
      'Traveler DNA básico',
      'Score de conversión (0–100)',
      'Kanban básico',
    ],
    notIncluded: ['Campañas de captación', 'Notificaciones email'],
    cta: 'Empieza gratis',
    highlighted: false, popular: false,
  },
  {
    id: 'PRO' as const,
    name: 'Pro',
    price: '$29',
    period: 'mes',
    description: 'Para agencias que quieren cerrar más deals.',
    features: [
      '2 agentes (owner + 1)',
      'Perfiles ilimitados',
      'Traveler DNA completo + IA insights',
      'Campañas de captación activas',
      'Notificaciones por email',
      'Kanban de leads',
      'Soporte prioritario',
    ],
    notIncluded: ['Kanban en tiempo real', 'Comparación campañas'],
    cta: 'Probar Pro',
    highlighted: true, popular: true,
  },
  {
    id: 'MAX' as const,
    name: 'Max',
    price: '$59',
    period: 'mes',
    description: 'Para agencias con equipos y múltiples operaciones.',
    features: [
      'Hasta 5 agentes',
      'Kanban en tiempo real',
      'Comparación de campañas',
      'Funciones avanzadas de IA',
      'Exportación CSV / Excel',
      'Onboarding dedicado',
      'SLA garantizado',
    ],
    notIncluded: [],
    cta: 'Contactar ventas',
    highlighted: false, popular: false,
  },
];
---

<section class="pricing section section--alt" id="pricing">
  <div class="container">

    <div class="pricing__hd reveal text-center">
      <div class="chip">Planes y precios</div>
      <h2 class="t-xl pricing__title">Un plan para cada etapa<br />de tu agencia.</h2>
      <p class="t-body" style="max-width:460px;margin-inline:auto;font-size:1.0625rem">
        Empieza gratis y escala cuando lo necesites.
        Sin contratos anuales. Sin sorpresas en tu factura.
      </p>
    </div>

    <div class="pricing__grid">
      {plans.map((p, i) => (
        <div class="reveal" style={`--d:${(i * 0.1).toFixed(1)}s`}>
          <PlanCard {...p} />
        </div>
      ))}
    </div>

    <!-- FAQ inline -->
    <div class="pricing__faq reveal" style="--d:0.3s">
      <h3 class="pricing__faq-title t-lg">Preguntas frecuentes</h3>
      <div class="pricing__faq-grid">
        {[
          { q: '¿Necesito tarjeta para el plan Free?', a: 'No. El plan Free es gratuito para siempre y no requiere tarjeta de crédito.' },
          { q: '¿Puedo cambiar de plan en cualquier momento?', a: 'Sí. Puedes actualizar o bajar de plan desde tu panel sin perder ningún dato.' },
          { q: '¿Qué pasa si supero los 5 perfiles en Free?', a: 'El sistema te notifica y puedes actualizar a Pro con un clic, sin interrupciones.' },
          { q: '¿El pago es mensual o anual?', a: 'Mensual por defecto. Próximamente ofreceremos descuento con plan anual.' },
          { q: '¿Hay onboarding incluido?', a: 'El plan Max incluye onboarding dedicado. Pro y Free tienen documentación completa.' },
          { q: '¿Los leads generados son míos?', a: '100%. Todos los datos de tus leads y clientes son de tu agencia. Puedes exportarlos en cualquier momento.' },
        ].map(faq => (
          <div class="pricing__faq-item">
            <p class="pricing__faq-q">{faq.q}</p>
            <p class="pricing__faq-a">{faq.a}</p>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.plan-cta-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const plan = (btn.getAttribute('data-plan') ?? 'FREE') as 'FREE' | 'PRO' | 'MAX';
      document.dispatchEvent(new CustomEvent('open-modal', { detail: { mode: 'register', plan } }));
    });
  });
</script>

<style>
  .pricing__hd {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--sp-5); margin-bottom: var(--sp-12);
  }
  .pricing__title { max-width: 400px; }

  .pricing__grid {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-5); align-items: start;
    margin-bottom: var(--sp-16);
    overflow: visible;
  }
  /* Padding-top en el PRO para que el badge no quede cortado */
  .pricing__grid > *:nth-child(2) { padding-top: 20px; }
  /* Side cards pushed down — Pro floats higher, Stripe-style */
  .pricing__grid > *:nth-child(1),
  .pricing__grid > *:nth-child(3) { margin-top: var(--sp-8); }

  .pricing__faq {
    background: var(--surface-lowest);
    border-radius: var(--r-xl);
    padding: var(--sp-10) var(--sp-8);
    box-shadow: var(--sh-sm);
  }
  .pricing__faq-title {
    margin-bottom: var(--sp-8); font-size: 1.375rem;
    color: var(--on-surface);
  }
  .pricing__faq-grid {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--sp-8);
  }
  .pricing__faq-item { display: flex; flex-direction: column; gap: var(--sp-2); }
  .pricing__faq-q { font-size: var(--text-sm); font-weight: 700; color: var(--on-surface); }
  .pricing__faq-a { font-size: var(--text-xs); color: var(--on-surface-var); line-height: 1.65; }

  @media (max-width: 900px) {
    .pricing__grid { grid-template-columns: 1fr; max-width: 420px; margin-inline: auto; }
    .pricing__grid > *:nth-child(2) { margin-top: 0; }
    .pricing__faq-grid { grid-template-columns: 1fr; }
  }
</style>
