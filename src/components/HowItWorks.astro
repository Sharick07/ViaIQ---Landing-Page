---
---

<section class="how section section--alt" id="how-it-works">
  <div class="container">

    <div class="how__hd text-center reveal">
      <div class="chip">Cómo funciona</div>
      <h2 class="t-xl how__title">
        De lead a cliente<br />en 5 pasos automáticos
      </h2>
      <p class="t-body how__sub">
        ViaIQ automatiza todo el proceso de cualificación.
        Tu agente solo interviene cuando el lead ya está listo para cerrar.
      </p>
    </div>

    <div class="how__layout">
      <!-- Timeline steps -->
      <div class="how__steps">
        {[
          {
            num: '01',
            title: 'El cliente responde el cuestionario',
            desc: 'Compartes un link de campaña. El cliente completa un cuestionario inteligente sobre destino, presupuesto, fechas y urgencia.',
            icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M12 2H5a2 2 0 00-2 2v14a2 2 0 002 2h10a2 2 0 002-2V8l-5-6z"
                    stroke="white" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 2v6h6M8 11h4M8 15h2" stroke="white" stroke-width="1.7" stroke-linecap="round"/>
            </svg>`,
          },
          {
            num: '02',
            title: 'ViaIQ analiza las respuestas con IA',
            desc: 'El motor IA procesa cada respuesta: detecta señales de compra, evalúa presupuesto real y mide la urgencia de forma determinista.',
            icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <circle cx="10" cy="10" r="8" stroke="white" stroke-width="1.7"/>
              <path d="M6.5 10l2.5 2.5 4-4.5" stroke="white" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>`,
          },
          {
            num: '03',
            title: 'Se genera el Traveler DNA™',
            desc: 'ViaIQ crea automáticamente el perfil completo: arquetipo de viajero, preferencias detectadas e insights accionables.',
            icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 2l1.8 3.8 4.2.6-3 3 .7 4.2L10 11.5 6.3 13.6l.7-4.2-3-3 4.2-.6L10 2z"
                    stroke="white" stroke-width="1.7" stroke-linejoin="round" stroke-linecap="round"/>
            </svg>`,
          },
          {
            num: '04',
            title: 'El lead recibe su score 0–100',
            desc: 'Cada perfil obtiene un score de conversión. Los leads HOT (70+) activan una notificación inmediata para que tu agente actúe.',
            icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M3 15l4-5 4 4 6-8" stroke="white" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>`,
          },
          {
            num: '05',
            title: 'Se organiza en el Kanban automáticamente',
            desc: 'El lead aparece en la columna correcta (Cold / Warm / Hot). Tu agente ve la prioridad de un vistazo y actúa con contexto completo.',
            icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none">
              <rect x="2" y="3" width="4" height="14" rx="1.5" stroke="white" stroke-width="1.7"/>
              <rect x="8" y="3" width="4" height="9" rx="1.5" stroke="white" stroke-width="1.7"/>
              <rect x="14" y="3" width="4" height="6" rx="1.5" stroke="white" stroke-width="1.7"/>
            </svg>`,
          },
        ].map((step, i) => (
          <div class="how__step reveal" style={`--d:${(i * 0.1).toFixed(1)}s`}>
            <div class="how__step-left">
              <div class="how__step-icon" set:html={step.icon} aria-hidden="true"></div>
              {i < 4 && <div class="how__connector" aria-hidden="true"></div>}
            </div>
            <div class="how__step-body">
              <span class="t-label how__step-num">{step.num}</span>
              <h3 class="how__step-title">{step.title}</h3>
              <p class="how__step-desc">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Right: sticky result preview -->
      <div class="how__preview reveal" style="--d:0.3s" aria-hidden="true">
        <p class="t-label how__preview-label">Resultado en tu panel</p>

        <div class="how__preview-card">
          <div class="how__prow how__prow--hot">
            <div class="how__prow-score">91</div>
            <div class="how__prow-info">
              <p class="how__prow-name">Andrea Pérez</p>
              <p class="how__prow-tag">🔥 HOT · Adventure Seeker</p>
            </div>
            <span class="how__badge how__badge--hot">Ahora</span>
          </div>
          <div class="how__prow how__prow--warm">
            <div class="how__prow-score how__prow-score--warm">74</div>
            <div class="how__prow-info">
              <p class="how__prow-name">Miguel Torres</p>
              <p class="how__prow-tag">🌡 Warm · Luxury Traveler</p>
            </div>
            <span class="how__badge">Seguir</span>
          </div>
          <div class="how__prow">
            <div class="how__prow-score how__prow-score--cold">22</div>
            <div class="how__prow-info">
              <p class="how__prow-name">Pedro Ruiz</p>
              <p class="how__prow-tag">❄ Cold · Casual Explorer</p>
            </div>
            <span class="how__badge how__badge--cold">Esperar</span>
          </div>
        </div>

        <div class="how__preview-note">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M2 7l3 3 7-7" stroke="var(--primary)" stroke-width="1.8"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Organizado automáticamente. Cero trabajo manual.</span>
        </div>

        <!-- Mini stat row -->
        <div class="how__preview-stats">
          <div class="how__preview-stat">
            <strong>30 seg</strong>
            <span>por lead</span>
          </div>
          <div class="how__preview-stat">
            <strong>IA</strong>
            <span>análisis auto</span>
          </div>
          <div class="how__preview-stat">
            <strong>0</strong>
            <span>trabajo manual</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .how { background: var(--surface-container); }

  .how__hd {
    display: flex; flex-direction: column; align-items: center;
    gap: var(--sp-5); margin-bottom: var(--sp-12);
  }
  .how__title { max-width: 480px; }
  .how__sub   { max-width: 420px; }

  .how__layout {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--sp-12);
    align-items: start;
  }

  /* Steps */
  .how__steps { display: flex; flex-direction: column; }

  .how__step {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: var(--sp-5);
    align-items: flex-start;
  }

  .how__step-left {
    display: flex; flex-direction: column; align-items: center;
  }

  .how__step-icon {
    width: 48px; height: 48px; border-radius: 50%;
    background: var(--grad-primary);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 8px 24px rgba(56,83,65,0.2);
    flex-shrink: 0;
  }

  .how__connector {
    width: 2px; flex: 1; min-height: 40px;
    background: linear-gradient(to bottom, var(--primary-container), transparent);
    border-radius: 2px; margin-block: var(--sp-3);
  }

  .how__step-body { padding-bottom: var(--sp-8); }
  .how__step:last-child .how__step-body { padding-bottom: 0; }

  .how__step-num { display: block; margin-bottom: var(--sp-2); color: var(--primary); }
  .how__step-title {
    font-family: var(--font-display);
    font-size: var(--text-md); font-weight: 700;
    color: var(--on-surface); letter-spacing: -0.015em;
    margin-bottom: var(--sp-2); line-height: 1.35;
  }
  .how__step-desc {
    font-size: var(--text-xs);
    color: var(--on-surface-var); line-height: 1.65;
  }

  /* Preview panel */
  .how__preview {
    position: sticky; top: 96px;
    background: var(--surface-lowest);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-lg);
    padding: var(--sp-6);
    display: flex; flex-direction: column; gap: var(--sp-5);
    border: 1px solid rgba(194,200,193,0.15);
  }

  .how__preview-label { color: var(--on-surface-muted); margin-bottom: 0; }

  .how__preview-card {
    display: flex; flex-direction: column; gap: var(--sp-2);
  }

  .how__prow {
    display: flex; align-items: center; gap: var(--sp-3);
    padding: var(--sp-3) var(--sp-4);
    border-radius: var(--r-md);
    background: var(--surface-low);
    transition: background var(--dur-fast);
  }
  .how__prow:hover { background: var(--surface-container); }
  .how__prow--hot {
    background: var(--primary-fixed);
    border: 1px solid rgba(56,83,65,0.18);
  }
  .how__prow--warm { background: #fff8ed; }

  .how__prow-score {
    font-family: var(--font-display);
    font-size: 1.25rem; font-weight: 900;
    color: var(--primary); letter-spacing: -0.03em;
    min-width: 34px;
  }
  .how__prow-score--warm { color: #7a5c2a; }
  .how__prow-score--cold { color: var(--on-surface-muted); }

  .how__prow-info { flex: 1; }
  .how__prow-name {
    font-size: var(--text-xs); font-weight: 700;
    color: var(--on-surface); line-height: 1.3;
  }
  .how__prow-tag { font-size: var(--text-micro); color: var(--on-surface-muted); }

  .how__badge {
    flex-shrink: 0;
    font-size: var(--text-micro); font-weight: 700;
    padding: 3px 10px; border-radius: var(--r-full);
    background: var(--surface-container);
    color: var(--on-surface-var);
  }
  .how__badge--hot  { background: var(--primary); color: white; }
  .how__badge--cold { background: var(--surface-highest); color: var(--on-surface-muted); }

  .how__preview-note {
    display: flex; align-items: center; gap: var(--sp-2);
    font-size: var(--text-xs); color: var(--on-surface-var);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--surface-container);
  }

  .how__preview-stats {
    display: grid; grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-3);
  }
  .how__preview-stat {
    display: flex; flex-direction: column; align-items: center;
    gap: 2px;
    background: var(--surface-low);
    border-radius: var(--r-md);
    padding: var(--sp-3);
  }
  .how__preview-stat strong {
    font-family: var(--font-display);
    font-size: 1rem; font-weight: 800;
    color: var(--primary); letter-spacing: -0.02em;
  }
  .how__preview-stat span {
    font-size: var(--text-micro); color: var(--on-surface-muted); text-align: center;
  }

  @media (max-width: 1000px) {
    .how__layout { grid-template-columns: 1fr; }
    .how__preview { position: static; }
  }
</style>
