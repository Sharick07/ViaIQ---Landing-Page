---
// AuthModal — floating registration / login modal
// All state is managed client-side via the inline script below
---

<!-- Backdrop -->
<div
  class="modal-backdrop"
  id="modal-backdrop"
  role="presentation"
  aria-hidden="true"
></div>

<!-- Dialog -->
<div
  class="modal"
  id="auth-modal"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
  hidden
>
  <!-- Close button -->
  <button class="modal__close" id="modal-close-btn" aria-label="Cerrar">
    <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
      <path d="M4 4l10 10M14 4L4 14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
  </button>

  <!-- Header -->
  <div class="modal__header">
    <div class="modal__logo" aria-hidden="true">
      <svg width="28" height="28" viewBox="0 0 36 36" fill="none">
        <circle cx="18" cy="18" r="16.5" stroke="var(--primary)" stroke-width="2.2"/>
        <rect x="12.5" y="12.5" width="11" height="11" rx="1.5" stroke="var(--primary)" stroke-width="2.2" transform="rotate(45 18 18)"/>
      </svg>
    </div>
    <h2 class="modal__title" id="modal-title">Crea tu cuenta</h2>
    <p class="modal__subtitle" id="modal-subtitle">
      Regístrate para comenzar con ViaIQ
    </p>
  </div>

  <!-- Plan indicator (shown when registering for a paid plan) -->
  <div class="modal__plan-badge" id="modal-plan-badge" hidden>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
      <path d="M7 1l1.6 3.4 3.7.5-2.7 2.6.6 3.7L7 9.5l-3.2 1.7.6-3.7L1.7 4.9l3.7-.5L7 1z"
            fill="#4CAF7D"/>
    </svg>
    <span id="modal-plan-text">Plan Pro seleccionado</span>
  </div>

  <!-- Form -->
  <form class="modal__form" id="auth-form" novalidate>
    <!-- Name field — only for register mode -->
    <div class="form-group" id="field-name">
      <label class="form-label" for="input-name">Nombre completo</label>
      <input
        class="form-input"
        type="text"
        id="input-name"
        name="name"
        placeholder="María García"
        autocomplete="name"
      />
    </div>

    <!-- Email -->
    <div class="form-group">
      <label class="form-label" for="input-email">Correo electrónico</label>
      <input
        class="form-input"
        type="email"
        id="input-email"
        name="email"
        placeholder="maria@agencia.com"
        autocomplete="email"
        required
      />
    </div>

    <!-- Password -->
    <div class="form-group">
      <label class="form-label" for="input-password">Contraseña</label>
      <input
        class="form-input"
        type="password"
        id="input-password"
        name="password"
        placeholder="Mínimo 8 caracteres"
        autocomplete="current-password"
        required
      />
    </div>

    <!-- Error message -->
    <div
      class="alert alert-error"
      id="modal-error"
      role="alert"
      hidden
      aria-live="assertive"
    ></div>

    <!-- Success message -->
    <div
      class="alert alert-success"
      id="modal-success"
      role="status"
      hidden
      aria-live="polite"
    ></div>

    <!-- Submit button -->
    <button
      type="submit"
      class="btn btn-primary btn-full"
      id="modal-submit-btn"
      aria-busy="false"
    >
      <span id="submit-label">Crear cuenta</span>
      <span class="spinner" id="submit-spinner" hidden aria-hidden="true"></span>
    </button>
  </form>

  <!-- Toggle between register / login -->
  <p class="modal__toggle">
    <span id="toggle-text">¿Ya tienes cuenta?</span>
    <button class="modal__toggle-btn" id="modal-toggle-btn" type="button">
      Inicia sesión
    </button>
  </p>
</div>

<script>
  import { register, login, getStoredToken, getStoredUser } from '../scripts/auth.js';
  import { startCheckout } from '../scripts/billing.js';

  // ── State ─────────────────────────────────────────────────
  let mode: 'register' | 'login' = 'register';
  let selectedPlan: 'FREE' | 'PRO' | 'MAX' | null = null;

  // ── Elements ──────────────────────────────────────────────
  const backdrop   = document.getElementById('modal-backdrop')!;
  const modal      = document.getElementById('auth-modal')!;
  const closeBtn   = document.getElementById('modal-close-btn')!;
  const form       = document.getElementById('auth-form') as HTMLFormElement;
  const submitBtn  = document.getElementById('modal-submit-btn') as HTMLButtonElement;
  const spinner    = document.getElementById('submit-spinner')!;
  const submitLbl  = document.getElementById('submit-label')!;
  const errorEl    = document.getElementById('modal-error')!;
  const successEl  = document.getElementById('modal-success')!;
  const fieldName  = document.getElementById('field-name')!;
  const titleEl    = document.getElementById('modal-title')!;
  const subtitleEl = document.getElementById('modal-subtitle')!;
  const toggleBtn  = document.getElementById('modal-toggle-btn')!;
  const toggleText = document.getElementById('toggle-text')!;
  const planBadge  = document.getElementById('modal-plan-badge')!;
  const planText   = document.getElementById('modal-plan-text')!;
  const nameInput  = document.getElementById('input-name') as HTMLInputElement;
  const emailInput = document.getElementById('input-email') as HTMLInputElement;
  const passInput  = document.getElementById('input-password') as HTMLInputElement;

  // ── Helpers ───────────────────────────────────────────────

  function openModal(newMode: 'register' | 'login', plan: typeof selectedPlan) {
    mode         = newMode;
    selectedPlan = plan;
    applyMode();
    clearMessages();
    form.reset();

    modal.hidden    = false;
    backdrop.classList.add('modal-backdrop--visible');
    document.body.style.overflow = 'hidden';

    // Focus first relevant input
    setTimeout(() => {
      (mode === 'register' ? nameInput : emailInput).focus();
    }, 60);
  }

  function closeModal() {
    modal.hidden = true;
    backdrop.classList.remove('modal-backdrop--visible');
    document.body.style.overflow = '';
    clearMessages();
    form.reset();
  }

  function applyMode() {
    if (mode === 'register') {
      titleEl.textContent    = 'Crea tu cuenta';
      subtitleEl.textContent = 'Regístrate para comenzar con ViaIQ';
      submitLbl.textContent  = selectedPlan && selectedPlan !== 'FREE'
        ? `Registrarme y suscribirme a ${selectedPlan}`
        : 'Crear cuenta gratis';
      toggleText.textContent = '¿Ya tienes cuenta?';
      toggleBtn.textContent  = 'Inicia sesión';
      fieldName.style.display = '';
      nameInput.required      = true;

      // Plan badge
      if (selectedPlan && selectedPlan !== 'FREE') {
        planText.textContent = `Plan ${selectedPlan} seleccionado`;
        planBadge.hidden     = false;
      } else {
        planBadge.hidden = true;
      }
    } else {
      titleEl.textContent    = 'Bienvenido de vuelta';
      subtitleEl.textContent = 'Ingresa a tu cuenta de ViaIQ';
      submitLbl.textContent  = 'Iniciar sesión';
      toggleText.textContent = '¿No tienes cuenta?';
      toggleBtn.textContent  = 'Regístrate gratis';
      fieldName.style.display = 'none';
      nameInput.required      = false;
      planBadge.hidden        = true;
    }
  }

  function setLoading(loading: boolean) {
    submitBtn.disabled = loading;
    submitBtn.setAttribute('aria-busy', String(loading));
    spinner.hidden    = !loading;
    spinner.setAttribute('aria-hidden', String(!loading));
  }

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.hidden      = false;
    successEl.hidden    = true;
  }

  function showSuccess(msg: string) {
    successEl.textContent = msg;
    successEl.hidden      = false;
    errorEl.hidden        = true;
  }

  function clearMessages() {
    errorEl.hidden   = true;
    successEl.hidden = true;
    errorEl.textContent   = '';
    successEl.textContent = '';
  }

  // ── Role guard ────────────────────────────────────────────

  function isAgentRole(): boolean {
    const user = getStoredUser();
    return user?.role === 'AGENT';
  }

  // ── Form submit ───────────────────────────────────────────

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearMessages();

    const email    = emailInput.value.trim();
    const password = passInput.value;
    const name     = nameInput.value.trim();

    // Basic client-side validation
    if (!email || !password) {
      showError('Por favor completa todos los campos.');
      return;
    }
    if (mode === 'register' && !name) {
      showError('Por favor ingresa tu nombre.');
      return;
    }
    if (password.length < 8) {
      showError('La contraseña debe tener al menos 8 caracteres.');
      return;
    }

    setLoading(true);

    try {
      if (mode === 'register') {
        // ── Register flow ───────────────────────────────────
        const { token, user } = await register(name, email, password);

        if (selectedPlan === 'FREE' || !selectedPlan) {
          // Free plan → show success and redirect to dashboard
          showSuccess('¡Registro exitoso! Redirigiendo...');
          setTimeout(() => {
            closeModal();
            window.location.href = '/success?plan=free';
          }, 1500);
        } else {
          // Paid plan → role check then checkout
          if (user.role === 'AGENT') {
            showError('Solo el propietario de la cuenta puede suscribirse a un plan pago. Contacta a tu administrador.');
            setLoading(false);
            return;
          }
          showSuccess('Cuenta creada. Redirigiendo a Stripe...');
          await startCheckout(selectedPlan, token);
          // startCheckout does window.location.href — execution stops here
        }

      } else {
        // ── Login flow ───────────────────────────────────────
        const { token, user } = await login(email, password);

        if (selectedPlan && selectedPlan !== 'FREE') {
          // User logged in and had a plan pending
          if (user.role === 'AGENT') {
            showError('Solo el propietario de la cuenta puede cambiar el plan. Contacta a tu administrador.');
            setLoading(false);
            return;
          }
          showSuccess('Sesión iniciada. Redirigiendo a Stripe...');
          await startCheckout(selectedPlan, token);
        } else {
          showSuccess('¡Bienvenido de vuelta! Redirigiendo...');
          setTimeout(() => {
            closeModal();
            window.location.href = '/success?plan=login';
          }, 1200);
        }
      }
    } catch (err: unknown) {
      const message = err instanceof Error ? err.message : 'Ocurrió un error inesperado. Intenta de nuevo.';
      showError(message);
      setLoading(false);
    }
  });

  // ── Toggle mode ───────────────────────────────────────────

  toggleBtn.addEventListener('click', () => {
    mode = mode === 'register' ? 'login' : 'register';
    clearMessages();
    form.reset();
    applyMode();
    setTimeout(() => emailInput.focus(), 30);
  });

  // ── Close triggers ────────────────────────────────────────

  closeBtn.addEventListener('click', closeModal);

  backdrop.addEventListener('click', closeModal);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.hidden) closeModal();
  });

  // ── Listen for open-modal event (fired by PlanCard / Navbar) ─

  document.addEventListener('open-modal', (e: Event) => {
    const { mode: newMode, plan } = (e as CustomEvent).detail as {
      mode: 'register' | 'login';
      plan: 'FREE' | 'PRO' | 'MAX' | null;
    };

    // If user already has a token and wants a paid plan → skip register, go straight to checkout
    const existingToken = getStoredToken();
    if (existingToken && plan && plan !== 'FREE') {
      const user = getStoredUser();
      if (user?.role === 'AGENT') {
        // Can't buy — just open modal to show the error
        openModal('login', plan);
        setTimeout(() => {
          showError('Solo el propietario de la cuenta puede cambiar el plan. Contacta a tu administrador.');
        }, 100);
        return;
      }
      // Owner already logged in — go straight to Stripe
      startCheckout(plan, existingToken).catch((err: unknown) => {
        const message = err instanceof Error ? err.message : 'Error al iniciar el pago';
        openModal('login', plan);
        setTimeout(() => showError(message), 100);
      });
      return;
    }

    openModal(newMode, plan);
  });
</script>

<style>
  /* ── Backdrop con blur ────────────────────────────────── */
  .modal-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(25, 28, 27, 0.55);
    backdrop-filter: blur(10px) saturate(1.2);
    -webkit-backdrop-filter: blur(10px) saturate(1.2);
    z-index: 200;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-slow) var(--ease-smooth);
  }
  .modal-backdrop--visible {
    opacity: 1;
    pointer-events: all;
  }

  /* ── Modal card ────────────────────────────────────────── */
  .modal[hidden] { display: none !important; }

  .modal {
    position: fixed;
    inset: 0;
    margin: auto;
    width: 100%;
    max-width: 440px;
    height: fit-content;
    max-height: 90vh;
    overflow-y: auto;
    background: var(--surface-lowest);
    border: 1px solid var(--surface-highest);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-xl), 0 0 0 1px rgba(56,83,65,0.06);
    z-index: 201;
    padding: var(--sp-8);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    animation: modal-in 0.28s var(--ease-spring);
  }

  @keyframes modal-in {
    from { opacity: 0; transform: scale(0.93) translateY(12px); }
    to   { opacity: 1; transform: scale(1)    translateY(0); }
  }

  /* ── Franja superior decorativa ──────────────────────── */
  .modal::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--primary) 0%, var(--primary-mid) 60%, var(--primary-fixed) 100%);
    border-radius: var(--r-xl) var(--r-xl) 0 0;
  }

  /* ── Botón cerrar ────────────────────────────────────── */
  .modal__close {
    position: absolute;
    top: var(--sp-5); right: var(--sp-5);
    width: 32px; height: 32px;
    border-radius: var(--r-md);
    display: flex; align-items: center; justify-content: center;
    color: var(--on-surface-muted);
    transition: background var(--dur-fast), color var(--dur-fast);
  }
  .modal__close:hover {
    background: var(--surface-container);
    color: var(--on-surface);
  }

  /* ── Header ──────────────────────────────────────────── */
  .modal__header {
    display: flex; flex-direction: column;
    align-items: center; text-align: center;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }

  .modal__logo {
    width: 52px; height: 52px;
    border-radius: var(--r-lg);
    background: var(--primary-fixed);
    display: flex; align-items: center; justify-content: center;
    margin-bottom: var(--sp-1);
  }

  .modal__title {
    font-family: Georgia, serif;
    font-size: 1.375rem; font-weight: 700;
    color: var(--on-surface);
    letter-spacing: -0.02em;
  }

  .modal__subtitle {
    font-size: 0.9375rem;
    color: var(--on-surface-muted);
    line-height: 1.5;
  }

  /* ── Plan badge ──────────────────────────────────────── */
  .modal__plan-badge[hidden] { display: none !important; }

  .modal__plan-badge {
    display: flex; align-items: center; justify-content: center;
    gap: var(--sp-2);
    background: var(--primary-fixed);
    color: var(--primary);
    font-size: 0.875rem; font-weight: 600;
    padding: var(--sp-2) var(--sp-4);
    border-radius: var(--r-full);
    border: 1px solid rgba(56,83,65,0.2);
  }

  /* ── Formulario ──────────────────────────────────────── */
  .modal__form {
    display: flex; flex-direction: column;
    gap: var(--sp-4);
  }

  /* Inputs heredados del global — refuerzo visual */
  .form-input {
    border-color: var(--surface-highest) !important;
    background: var(--surface-low) !important;
    transition: border-color var(--dur-fast), box-shadow var(--dur-fast);
  }
  .form-input:focus {
    border-color: var(--primary) !important;
    box-shadow: 0 0 0 3px var(--primary-fixed) !important;
    background: var(--surface-lowest) !important;
    outline: none;
  }

  /* ── Toggle login/registro ───────────────────────────── */
  .modal__toggle {
    text-align: center;
    font-size: 0.9rem;
    color: var(--on-surface-muted);
  }
  .modal__toggle-btn {
    color: var(--primary);
    font-weight: 600; font-size: 0.9rem;
    margin-left: 4px;
    transition: opacity var(--dur-fast);
  }
  .modal__toggle-btn:hover { opacity: 0.7; text-decoration: underline; }

  /* ── Mobile ──────────────────────────────────────────── */
  @media (max-width: 520px) {
    .modal {
      border-radius: var(--r-xl) var(--r-xl) 0 0;
      top: auto; bottom: 0;
      max-height: 92vh;
      animation: modal-up 0.28s var(--ease-spring);
    }
    @keyframes modal-up {
      from { transform: translateY(40px); opacity: 0; }
      to   { transform: translateY(0);    opacity: 1; }
    }
  }
</style>
