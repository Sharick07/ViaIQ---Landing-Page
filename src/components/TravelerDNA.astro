---
---
<section class="dna section">
  <div class="container dna__inner">

    <!-- Copy -->
    <div class="dna__copy">
      <div class="chip reveal">Traveler DNA™</div>
      <h2 class="t-xl reveal" style="--d:0.07s;max-width:420px">
        Conoce a tu cliente<br />antes de hablarle.
      </h2>
      <p class="t-body reveal" style="--d:0.14s;max-width:440px;font-size:1.0625rem">
        Cada lead que entra a ViaIQ completa un cuestionario inteligente.
        En segundos, el sistema genera un perfil completo con arquetipo,
        preferencias detectadas e insights accionables generados por IA.
      </p>

      <ul class="dna__list reveal" style="--d:0.2s">
        {[
          'Score de conversión 0–100 automático',
          'Arquetipo: Adventure Seeker, Luxury, Family & más',
          'Presupuesto, urgencia y destino analizados por IA',
          'Insights accionables para cerrar la venta',
        ].map(b => (
          <li class="dna__list-item">
            <span class="dna__check">
              <svg width="11" height="11" viewBox="0 0 11 11" fill="none">
                <path d="M1.5 5.5l3 3 5-5" stroke="white" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
            <span>{b}</span>
          </li>
        ))}
      </ul>

      <div class="dna__cta reveal" style="--d:0.26s">
        <button class="btn btn-primary dna-open-modal">
          Ver mi Traveler DNA de prueba
        </button>
      </div>
    </div>

    <!-- Profile Card -->
    <div class="dna__card-wrap reveal-right" style="--d:0.1s" aria-hidden="true">

      <div class="dna-card">
        <!-- Header -->
        <div class="dna-card__header">
          <div class="dna-card__av-wrap">
            <div class="dna-card__av">AP</div>
            <div class="dna-card__av-ring"></div>
          </div>
          <div>
            <p class="dna-card__name">Andrea Pérez</p>
            <p class="dna-card__email">andrea.p@email.com</p>
          </div>
          <div class="dna-card__hot-badge">🔥 HOT</div>
        </div>

        <!-- Score -->
        <div class="dna-card__score-row">
          <div class="dna-card__ring-box">
            <svg width="88" height="88" viewBox="0 0 88 88">
              <circle cx="44" cy="44" r="36" fill="none"
                      stroke="var(--surface-low)" stroke-width="9"/>
              <circle cx="44" cy="44" r="36" fill="none"
                      stroke="url(#score-grad)" stroke-width="9"
                      stroke-linecap="round"
                      stroke-dasharray="205 230"
                      stroke-dashoffset="57"
                      transform="rotate(-90 44 44)"/>
              <defs>
                <linearGradient id="score-grad" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stop-color="#385341"/>
                  <stop offset="100%" stop-color="#506b58"/>
                </linearGradient>
              </defs>
            </svg>
            <div class="dna-card__ring-label">
              <span>91</span>
              <small>/100</small>
            </div>
          </div>
          <div class="dna-card__score-meta">
            <p class="dna-card__score-title">Score de conversión</p>
            <p class="dna-card__score-sub">Alta probabilidad de compra</p>
            <div class="dna-card__archetype chip">🌍 Adventure Seeker</div>
          </div>
        </div>

        <!-- Breakdown bars -->
        <div class="dna-card__bars">
          {[
            { label: 'Presupuesto', pct: 90 },
            { label: 'Urgencia', pct: 85 },
            { label: 'Claridad destino', pct: 78 },
            { label: 'Engagement', pct: 95 },
          ].map(b => (
            <div class="dna-card__bar-row">
              <span>{b.label}</span>
              <div class="dna-card__bar-track">
                <div class="dna-card__bar-fill" style={`width:${b.pct}%`}></div>
              </div>
              <span class="dna-card__bar-val">{b.pct}</span>
            </div>
          ))}
        </div>

        <!-- Tags -->
        <div class="dna-card__tags-section">
          <p class="t-label dna-card__tags-title">Preferencias detectadas</p>
          <div class="dna-card__tags">
            {['Maldivas', 'Presupuesto alto', 'Urgente <30d', 'Pareja', 'Lujo', 'Todo incluido'].map(t => (
              <span class="dna-card__tag">{t}</span>
            ))}
          </div>
        </div>

        <!-- AI Insight -->
        <div class="dna-card__insight">
          <div class="dna-card__insight-header">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
              <path d="M7 1l1.3 2.8 3.1.5-2.2 2.1.5 3.1L7 8 4.3 9.5l.5-3.1L2.6 4.3l3.1-.5L7 1z"
                    fill="var(--primary)"/>
            </svg>
            <span class="t-label">Insight IA</span>
          </div>
          <p class="dna-card__insight-text">
            "Andrea busca un viaje de aniversario en los próximos 30 días. Presupuesto
            flexible — prioriza experiencia y privacidad sobre precio. Propón paquete
            exclusivo en Maldivas con villa overwater."
          </p>
        </div>
      </div>

      <!-- Floating badge -->
      <div class="dna__float-stat">
        <span class="dna__float-val">30 seg</span>
        <span class="dna__float-lbl">del formulario al perfil completo</span>
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll('.dna-open-modal').forEach(b =>
    b.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('open-modal', { detail: { mode: 'register', plan: 'FREE' } }))
    )
  );
</script>

<style>
  .dna { background: var(--surface); }

  .dna__inner {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(var(--sp-10), 5vw, var(--sp-20));
    align-items: center;
  }

  .dna__copy { display: flex; flex-direction: column; gap: var(--sp-6); }

  .dna__list { display: flex; flex-direction: column; gap: var(--sp-3); }
  .dna__list-item {
    display: flex; align-items: flex-start; gap: var(--sp-3);
    font-size: var(--text-sm); color: var(--on-surface-var);
  }
  .dna__check {
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--primary); flex-shrink: 0; margin-top: 2px;
    display: flex; align-items: center; justify-content: center;
  }

  /* ── Card ─────────────────── */
  .dna__card-wrap { position: relative; }

  .dna-card {
    background: var(--surface-lowest);
    border-radius: var(--r-xl);
    box-shadow: var(--sh-xl);
    padding: var(--sp-8);
    display: flex; flex-direction: column; gap: var(--sp-5);
    border: 1px solid rgba(194,200,193,0.1);
  }

  /* Header */
  .dna-card__header {
    display: flex; align-items: center; gap: var(--sp-3);
  }
  .dna-card__av-wrap { position: relative; flex-shrink: 0; }
  .dna-card__av {
    width: 44px; height: 44px; border-radius: 50%;
    background: var(--grad-primary);
    display: flex; align-items: center; justify-content: center;
    font-family: var(--font-display); font-weight: 900; font-size: 0.875rem;
    color: white;
  }
  .dna-card__av-ring {
    position: absolute; inset: -3px; border-radius: 50%;
    border: 2px solid var(--primary-fixed);
    animation: pulse-glow 2.5s ease-in-out infinite;
  }
  .dna-card__name {
    font-weight: 700; font-size: var(--text-sm); color: var(--on-surface);
  }
  .dna-card__email { font-size: var(--text-micro); color: var(--on-surface-muted); }
  .dna-card__hot-badge {
    margin-left: auto;
    background: var(--primary-fixed); color: var(--on-primary-fixed);
    font-size: var(--text-micro); font-weight: 800;
    padding: 4px 12px; border-radius: var(--r-full);
  }

  /* Score ring */
  .dna-card__score-row {
    display: flex; align-items: center; gap: var(--sp-5);
    background: var(--surface-low); border-radius: var(--r-lg); padding: var(--sp-5);
  }
  .dna-card__ring-box { position: relative; flex-shrink: 0; }
  .dna-card__ring-label {
    position: absolute; inset: 0;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: 0;
  }
  .dna-card__ring-label span {
    font-family: var(--font-display);
    font-size: 1.5rem; font-weight: 900;
    color: var(--primary); letter-spacing: -0.03em; line-height: 1;
  }
  .dna-card__ring-label small { font-size: 0.5625rem; color: var(--on-surface-muted); }
  .dna-card__score-title {
    font-size: var(--text-sm); font-weight: 700; color: var(--on-surface); margin-bottom: 2px;
  }
  .dna-card__score-sub { font-size: var(--text-micro); color: var(--on-surface-muted); margin-bottom: var(--sp-3); }
  .dna-card__archetype { font-size: var(--text-micro); }

  /* Bars */
  .dna-card__bars { display: flex; flex-direction: column; gap: var(--sp-3); }
  .dna-card__bar-row {
    display: grid; grid-template-columns: 120px 1fr 28px;
    align-items: center; gap: var(--sp-3);
    font-size: var(--text-micro); color: var(--on-surface-var);
  }
  .dna-card__bar-track {
    height: 5px; background: var(--surface-low); border-radius: var(--r-full); overflow: hidden;
  }
  .dna-card__bar-fill {
    height: 100%; background: var(--grad-primary); border-radius: var(--r-full);
    transition: width 1.2s var(--ease-out);
  }
  .dna-card__bar-val { font-weight: 700; color: var(--primary); text-align: right; }

  /* Tags */
  .dna-card__tags-section { display: flex; flex-direction: column; gap: var(--sp-3); }
  .dna-card__tags-title { color: var(--on-surface-muted); }
  .dna-card__tags { display: flex; flex-wrap: wrap; gap: var(--sp-2); }
  .dna-card__tag {
    background: var(--surface-container);
    color: var(--on-surface-var);
    font-size: var(--text-micro); font-weight: 600;
    padding: 4px 10px; border-radius: var(--r-full);
  }

  /* Insight */
  .dna-card__insight {
    background: var(--primary-fixed);
    border-radius: var(--r-lg);
    padding: var(--sp-4) var(--sp-5);
    display: flex; flex-direction: column; gap: var(--sp-2);
  }
  .dna-card__insight-header {
    display: flex; align-items: center; gap: var(--sp-2);
    color: var(--on-primary-fixed);
  }
  .dna-card__insight-text {
    font-size: var(--text-xs); font-style: italic;
    color: var(--on-primary-fixed); line-height: 1.6;
  }

  /* Floating stat */
  .dna__float-stat {
    position: absolute; bottom: -18px; left: -18px;
    background: var(--surface-lowest);
    border-radius: var(--r-lg); box-shadow: var(--sh-md);
    padding: var(--sp-4) var(--sp-5);
    display: flex; flex-direction: column; gap: 3px;
    border: 1px solid rgba(194,200,193,0.1);
    animation: float-y2 3.5s ease-in-out infinite;
  }
  .dna__float-val {
    font-family: var(--font-display);
    font-size: 1.625rem; font-weight: 900;
    color: var(--primary); letter-spacing: -0.03em;
  }
  .dna__float-lbl { font-size: var(--text-micro); color: var(--on-surface-muted); max-width: 130px; line-height: 1.4; }

  @media (max-width: 900px) {
    .dna__inner { grid-template-columns: 1fr; }
    .dna__float-stat { left: auto; right: 0; bottom: -14px; }
  }
</style>
