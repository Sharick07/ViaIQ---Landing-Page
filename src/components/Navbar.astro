---
---
<header class="nav" id="nav">
  <div class="container nav__inner">
    <a href="/" class="nav__logo">
      <svg class="nav__compass" width="36" height="36" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <circle cx="18" cy="18" r="16.5" stroke="var(--primary)" stroke-width="2"/>
        <rect x="12.5" y="12.5" width="11" height="11" rx="1.5" stroke="var(--primary)" stroke-width="2" transform="rotate(45 18 18)"/>
      </svg>
      <span class="nav__name">ViaIQ</span>
    </a>

    <nav class="nav__links" aria-label="Principal">
      <a href="#features"     class="nav__link">Funciones</a>
      <a href="#how-it-works" class="nav__link">Cómo funciona</a>
      <a href="#pricing"      class="nav__link">Planes</a>
    </nav>

    <div class="nav__ctas">
      <button class="nav__cta-login nav-login-btn" type="button">Iniciar sesión</button>
      <button class="nav__cta-register btn btn-primary nav-register-btn" type="button">Empezar gratis</button>
    </div>

    <button class="nav__burger" id="nav-burger" aria-label="Menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__drawer" id="nav-drawer" aria-hidden="true">
    <nav class="nav__drawer-links">
      <a href="#features">Funciones</a>
      <a href="#how-it-works">Cómo funciona</a>
      <a href="#pricing">Planes</a>
    </nav>
    <div class="nav__drawer-ctas">
      <button class="btn btn-secondary nav-login-btn" style="width:100%" type="button">Iniciar sesión</button>
      <button class="btn btn-primary nav-register-btn" style="width:100%" type="button">Empezar gratis</button>
    </div>
  </div>
</header>

<script>
  const nav    = document.getElementById('nav')!;
  const burger = document.getElementById('nav-burger')!;
  const drawer = document.getElementById('nav-drawer')!;

  window.addEventListener('scroll', () => {
    nav.classList.toggle('nav--solid', window.scrollY > 16);
  }, { passive: true });

  const toggleDrawer = () => {
    const open = drawer.classList.toggle('nav__drawer--open');
    burger.setAttribute('aria-expanded', String(open));
    burger.classList.toggle('nav__burger--open', open);
  };
  burger.addEventListener('click', toggleDrawer);
  drawer.querySelectorAll('a').forEach(a => a.addEventListener('click', () => {
    drawer.classList.remove('nav__drawer--open');
    burger.classList.remove('nav__burger--open');
  }));

  document.querySelectorAll('.nav-login-btn').forEach(b =>
    b.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('open-modal', { detail: { mode: 'login', plan: null } }))
    )
  );
  document.querySelectorAll('.nav-register-btn').forEach(b =>
    b.addEventListener('click', () =>
      document.dispatchEvent(new CustomEvent('open-modal', { detail: { mode: 'register', plan: 'FREE' } }))
    )
  );
</script>

<style>
  .nav {
    position: fixed; top: 0; inset-inline: 0; z-index: 200;
    transition: background var(--dur-slow) var(--ease-smooth),
                backdrop-filter var(--dur-slow) var(--ease-smooth),
                box-shadow var(--dur-slow) var(--ease-smooth);
  }
  .nav--solid {
    background: rgba(249,250,248,0.85);
    backdrop-filter: blur(24px) saturate(1.4);
    -webkit-backdrop-filter: blur(24px) saturate(1.4);
    box-shadow: 0 1px 0 rgba(194,200,193,0.25), var(--sh-sm);
  }

  .nav__inner {
    display: flex; align-items: center;
    height: 68px; gap: var(--sp-8);
    position: relative;
  }

  /* Logo */
  .nav__logo {
    display: flex; align-items: center; gap: var(--sp-3); flex-shrink: 0;
  }
  .nav__compass {
    transition: transform var(--dur-mid) var(--ease-spring);
    flex-shrink: 0;
  }
  .nav__logo:hover .nav__compass { transform: rotate(-10deg) scale(1.06); }
  .nav__name {
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 1.5rem; font-weight: 700;
    letter-spacing: -0.01em; color: var(--primary);
  }
  /* Links — centered like Stripe */
  .nav__links {
    display: flex; align-items: center; gap: var(--sp-8);
    position: absolute; left: 50%; transform: translateX(-50%);
  }
  .nav__link {
    font-size: var(--text-xs); font-weight: 500;
    color: var(--on-surface-var);
    position: relative; padding-bottom: 2px;
    transition: color var(--dur-fast);
  }
  .nav__link::after {
    content: '';
    position: absolute; bottom: -2px; left: 0; right: 0;
    height: 1.5px; background: var(--primary);
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--dur-mid) var(--ease-out);
    border-radius: 2px;
  }
  .nav__link:hover { color: var(--primary); }
  .nav__link:hover::after { transform: scaleX(1); }

  /* Burger */
  .nav__burger {
    display: none; flex-direction: column; gap: 5px;
    width: 36px; height: 36px; align-items: center; justify-content: center;
    border-radius: var(--r-md); margin-left: auto;
    transition: background var(--dur-fast);
  }
  .nav__burger:hover { background: var(--surface-low); }
  .nav__burger span {
    display: block; width: 20px; height: 1.5px;
    background: var(--on-surface); border-radius: 2px;
    transition: transform var(--dur-mid) var(--ease-out), opacity var(--dur-mid);
  }
  .nav__burger--open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
  .nav__burger--open span:nth-child(2) { opacity: 0; }
  .nav__burger--open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

  /* Mobile drawer */
  .nav__drawer {
    display: none; flex-direction: column; gap: var(--sp-6);
    padding: var(--sp-5) var(--sp-6) var(--sp-8);
    background: rgba(249,250,248,0.97);
    backdrop-filter: blur(24px);
    border-top: 1px solid rgba(194,200,193,0.15);
    animation: slide-down 0.25s var(--ease-out);
  }
  .nav__drawer-links {
    display: flex; flex-direction: column; gap: var(--sp-1);
  }
  .nav__drawer-links a {
    font-size: var(--text-md); font-weight: 600;
    color: var(--on-surface); padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--surface-low);
  }
  .nav__drawer-ctas {
    display: flex; flex-direction: column; gap: var(--sp-3);
    padding-top: var(--sp-2);
  }
  .nav__drawer--open { display: flex; }

  @keyframes slide-down {
    from { opacity: 0; transform: translateY(-8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* CTAs */
  .nav__ctas {
    display: flex; align-items: center; gap: var(--sp-3);
    margin-left: auto;
  }
  .nav__cta-login {
    font-size: var(--text-xs); font-weight: 500;
    color: var(--on-surface-var);
    padding: 7px var(--sp-4);
    border-radius: var(--r-full);
    transition: color var(--dur-fast), background var(--dur-fast);
  }
  .nav__cta-login:hover { color: var(--primary); background: var(--primary-fixed); }
  .nav__cta-register {
    font-size: var(--text-xs); padding: 8px 20px;
    border-radius: var(--r-full);
  }

  @media (max-width: 768px) {
    .nav__links, .nav__ctas { display: none; }
    .nav__burger { display: flex; }
  }
</style>
