---
// Marquee de agencias que usan ViaIQ — prueba social inmediata
const agencies = [
  'Viajes Éxodo',  'TravelPro LATAM', 'Mundo Boutique',
  'Destinos Elite', 'Nexo Viajes',    'Global Tours MX',
  'Ruta Perfecta', 'Serenity Travel', 'Aventura & Co',
  'Voyager Hub',   'Compass Agency',  'Nomada Curated',
];
// Duplicar para el loop infinito
const all = [...agencies, ...agencies];
---

<div class="logobar section--low">
  <div class="container logobar__header">
    <p class="t-label logobar__label">
      Confiado por más de 200 agencias en Latinoamérica
    </p>
  </div>
  <div class="marquee-wrap">
    <div class="marquee-track">
      {all.map((name) => (
        <div class="logobar__item">
          <div class="logobar__icon" aria-hidden="true">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
              <path d="M1.5 9.5L6 14L14.5 5" stroke="currentColor" stroke-width="1.8"
                    stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </div>
          <span>{name}</span>
        </div>
      ))}
    </div>
  </div>
</div>

<style>
  .logobar {
    padding-block: var(--sp-8);
    border-top: 1px solid var(--surface-container);
    border-bottom: 1px solid var(--surface-container);
  }

  .logobar__header {
    text-align: center;
    margin-bottom: var(--sp-6);
  }

  .logobar__label { color: var(--on-surface-muted); }

  .logobar__item {
    display: flex; align-items: center; gap: var(--sp-2);
    color: var(--on-surface-muted); white-space: nowrap;
    font-size: var(--text-xs); font-weight: 600;
    letter-spacing: -0.01em;
    transition: color var(--dur-fast);
  }
  .logobar__item:hover { color: var(--primary); }

  .logobar__icon {
    width: 26px; height: 26px; border-radius: var(--r-sm);
    background: var(--primary-fixed);
    color: var(--primary);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
  }
</style>
