---
// Valor Diferencial — "por qué ViIQ y no cualquier CRM genérico"
// Why: neutralizes the "ya uso Excel / WhatsApp / otro CRM" objection

const diffs = [
  {
    label: 'CRM genérico',
    items: [
      'Diseñado para vendedores B2B, no boutiques',
      'Interfaz compleja, meses de configuración',
      'Demasiadas funciones que nunca usarás',
      'Soporte lento en inglés',
    ],
    isViaiq: false,
  },
  {
    label: 'ViIQ',
    items: [
      'Creado exclusivamente para el comercio de moda',
      'Lista en minutos, no en semanas',
      'Solo lo que tu boutique realmente necesita',
      'Soporte en español, respuesta en horas',
    ],
    isViaiq: true,
  },
];

const testimonials = [
  {
    quote: 'Antes perdía el tiempo buscando en WhatsApp quién era quién. Con ViIQ tengo todo en segundos.',
    name: 'Daniela Moreno',
    role: 'Dueña, Boutique Lunaire — Bogotá',
    initials: 'DM',
  },
  {
    quote: 'El recordatorio de seguimiento me ayudó a recuperar clientes que no visitaban hace 3 meses. Real.',
    name: 'Sofía Herrera',
    role: 'Gerente, Studio Mode — Medellín',
    initials: 'SH',
  },
  {
    quote: 'Mis vendedoras lo aprendieron en 20 minutos. No tuve que enseñarles nada yo.',
    name: 'Ana Castillo',
    role: 'Fundadora, Áurea Boutique — CDMX',
    initials: 'AC',
  },
];
---

<section class="vd section-pad">
  <div class="container">

    <!-- Comparison -->
    <div class="vd__comp reveal">
      <div class="chip">¿Por qué ViIQ?</div>
      <h2 class="display-md vd__comp-title">
        Hecho para boutiques.<br />No adaptado para ellas.
      </h2>

      <div class="vd__table">
        {diffs.map((col) => (
          <div class:list={['vd__col', { 'vd__col--viaiq': col.isViaiq }]}>
            <div class="vd__col-header">
              {col.isViaiq && (
                <div class="vd__logo-mark" aria-hidden="true">
                  <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M3 9l4.5 4.5 7.5-9" stroke="white"
                          stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </div>
              )}
              <span class="vd__col-label">{col.label}</span>
            </div>
            <ul class="vd__col-list">
              {col.items.map((item) => (
                <li class="vd__col-item">
                  <span class="vd__col-dot" aria-hidden="true"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <!-- Testimonials -->
    <div class="vd__testimonials">
      <h3 class="display-sm vd__t-title reveal">Lo que dicen nuestras boutiques</h3>

      <div class="vd__t-grid">
        {testimonials.map((t, i) => (
          <div class="vd__t-card reveal" style={`--delay:${(i * 0.1).toFixed(1)}s`}>
            <p class="vd__t-quote">"{t.quote}"</p>
            <div class="vd__t-author">
              <div class="vd__t-avatar">{t.initials}</div>
              <div>
                <strong class="vd__t-name">{t.name}</strong>
                <span class="vd__t-role">{t.role}</span>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<style>
  .vd {
    background: var(--surface);
  }

  /* ── Comparison ──────────────────────────────────────── */
  .vd__comp {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    text-align: center;
    margin-bottom: var(--space-16);
  }

  .vd__comp-title { max-width: 480px; }

  .vd__table {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    width: 100%;
    max-width: 720px;
    text-align: left;
  }

  .vd__col {
    background: var(--surface-lowest);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    box-shadow: var(--shadow-ambient-sm);
  }

  .vd__col--viaiq {
    background: var(--primary);
  }

  .vd__col-header {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
  }

  .vd__logo-mark {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    background: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .vd__col-label {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 700;
    color: var(--on-surface);
  }

  .vd__col--viaiq .vd__col-label { color: var(--on-primary); }

  .vd__col-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .vd__col-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--text-body-sm);
    color: var(--on-surface-variant);
    line-height: 1.5;
  }

  .vd__col--viaiq .vd__col-item { color: rgba(255,255,255,0.85); }

  .vd__col-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--outline-variant);
    flex-shrink: 0;
    margin-top: 6px;
  }

  .vd__col--viaiq .vd__col-dot { background: rgba(255,255,255,0.5); }

  /* ── Testimonials ────────────────────────────────────── */
  .vd__testimonials {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .vd__t-title {
    text-align: center;
  }

  .vd__t-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
  }

  .vd__t-card {
    background: var(--surface-lowest);
    border-radius: var(--radius-xl);
    padding: var(--space-8);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    box-shadow: var(--shadow-ambient-sm);
  }

  .vd__t-quote {
    font-size: var(--text-body-md);
    color: var(--on-surface-variant);
    line-height: 1.65;
    font-style: italic;
    flex: 1;
  }

  .vd__t-author {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .vd__t-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--primary-fixed);
    color: var(--on-primary-fixed);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.875rem;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .vd__t-name {
    display: block;
    font-size: var(--text-body-sm);
    font-weight: 600;
    color: var(--on-surface);
  }

  .vd__t-role {
    display: block;
    font-size: 0.75rem;
    color: var(--on-surface-muted);
  }

  @media (max-width: 900px) {
    .vd__table    { grid-template-columns: 1fr; }
    .vd__t-grid   { grid-template-columns: 1fr; }
  }
</style>
