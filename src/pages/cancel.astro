---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Pago cancelado — ViaIQ">
  <div class="cancel-page">
    <div class="cancel-card">
      <div class="cancel-icon" aria-hidden="true">
        <svg viewBox="0 0 64 64" fill="none" width="64" height="64">
          <circle cx="32" cy="32" r="32" fill="#fef2f2"/>
          <path d="M22 22l20 20M42 22L22 42"
                stroke="var(--color-error)"
                stroke-width="3.5"
                stroke-linecap="round"/>
        </svg>
      </div>

      <div class="cancel-text">
        <h1>Pago cancelado</h1>
        <p>
          Cancelaste el proceso de pago. No se realizó ningún cargo.
          Puedes intentarlo nuevamente cuando lo desees.
        </p>
      </div>

      <a href="/#pricing" class="btn btn-primary btn-lg">
        Volver a los planes
      </a>

      <a href="/" class="btn btn-ghost">
        Ir al inicio
      </a>
    </div>
  </div>
</Layout>

<style>
  @import '../styles/global.css';

  .cancel-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-beige);
    padding: var(--space-6);
  }

  .cancel-card {
    background: var(--color-white);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-modal);
    padding: var(--space-12) var(--space-10);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    max-width: 420px;
    width: 100%;
    text-align: center;
    animation: card-in 0.35s ease-out;
  }

  @keyframes card-in {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .cancel-icon {
    animation: pop-in 0.4s cubic-bezier(0.34, 1.4, 0.64, 1);
  }

  @keyframes pop-in {
    from { transform: scale(0.6); opacity: 0; }
    to   { transform: scale(1);   opacity: 1; }
  }

  .cancel-text h1 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-black);
    margin-bottom: var(--space-2);
  }

  .cancel-text p {
    font-size: 1rem;
    color: var(--color-gray-mid);
    line-height: 1.65;
  }
</style>
